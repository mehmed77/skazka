# ─────────────────────────────────────────────────────────────
# SKAZKA — environment variables (namuna)
# Nusxa oling: cp .env.example .env  (qiymatlarni to'ldiring)
# ─────────────────────────────────────────────────────────────

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
POSTGRES_DB=skazka
POSTGRES_USER=skazka
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (kesh + Celery broker)
REDIS_URL=redis://redis:6379/0

# MinIO (S3-mos media saqlash — audio/rasm)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=skazka-media
MINIO_REGION=us-east-1
# Brauzerdan media olish uchun ochiq domen (signed URL host'i)
MINIO_PUBLIC_DOMAIN=localhost:9000/skazka-media

# Email (SMTP) — dev'da console backend ishlatiladi
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SKAZKA <no-reply@example.uz>

# Frontend (Next.js) — nginx orqali API bazaviy manzil
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
